{
  // Cloudflare Workers static-assets deploy of the Next.js static export.
  // Build: `npm run build` (writes ./out). Deploy: `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vfvicera-portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "vvicera.kx-lab.org", "custom_domain": true }
  ]
}
